# ---------------------------------------------------------------------------
# Nova Mart environment template.
#
#   cp .env.example .env
#
# The two secrets below have NO default anywhere in the application. A service
# started without them fails at boot with an explicit message rather than
# quietly falling back to a value that is published in this repository. That is
# the point: a development default that reaches production is how demo
# credentials become incidents.
#
# For a real deployment, generate fresh values:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------

# Signs and verifies every access and refresh token. Minimum 32 bytes for HS256.
NOVAMART_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Shared credential for service-to-service calls. The gateway strips this header
# from every inbound request, so it can never be supplied by a client.
NOVAMART_INTERNAL_TOKEN=change-me-to-another-long-random-string

# ---- database -------------------------------------------------------------
DB_USERNAME=root
DB_PASSWORD=zeno7925
MYSQL_ROOT_PASSWORD=zeno7925
MYSQL_USER=root
MYSQL_PASSWORD=zeno7925
MYSQL_HOST=localhost
MYSQL_PORT=3306
POSTGRES_USER=novamart
POSTGRES_PASSWORD=zeno7925
POSTGRES_DB=novamart

# ---- frontend -------------------------------------------------------------
# Where the browser reaches the gateway. Baked into the client bundle at build
# time, so changing it requires a rebuild rather than a restart.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Origins the gateway will accept cross-origin requests from. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- commercial rules -----------------------------------------------------
FREE_DELIVERY_THRESHOLD=999.00
DELIVERY_FEE=79.00

# ---- logging --------------------------------------------------------------
LOG_LEVEL=INFO
